# "Pattern Algebra" — BeatForge Script Reference
# Every feature demonstrated with examples

# ════════════════════════════════════
#  SETUP
# ════════════════════════════════════
bpm 120
swing 0
steps 16

# ════════════════════════════════════
#  1. TRACKER NOTATION
# ════════════════════════════════════
# x=hard o=medium +=soft .=rest
kick     "x...x...x...x..."
snare    "....x.......x..."
hh       "x.o+x.o+x.o+x.o+"

# ════════════════════════════════════
#  2. MINI-NOTATION (Strudel-style)
# ════════════════════════════════════
# Sequence:     "kick snare hh clap"
# Subdivision:  "[snare clap]"
# Speed up:     "hh*8"
# Alternation:  "<kick snare hh>"
# Euclidean:    "kick(3,16)"
# Degrade:      "hh*8?0.5"
# Stack:        "kick , snare"
# Weight:       "kick@2 snare"
# Replicate:    "bd!2 sd"

# ════════════════════════════════════
#  3. VARIABLES
# ════════════════════════════════════
# let name = value
# use with $name or {name}
let beat = x...x...x...x...
# kick "$beat"

# ════════════════════════════════════
#  4. MELODY & CHORDS
# ════════════════════════════════════
# Note names:
note "C4 E4 G4 C5 ~ G4 E4 C4"

# Chord progressions:
chord "Am Dm G C"

# Scale + degrees:
scale C major
deg "0 2 4 5 7 5 4 2"

# ════════════════════════════════════
#  5. MIX FROM CODE
# ════════════════════════════════════
vol kick 0.90
vol hh 0.50
pan hh -0.25
lpf hh 5000
sendverb snare 0.20
sidechain kick hh

# ════════════════════════════════════
#  6. MASTER EFFECTS
# ════════════════════════════════════
reverb 0.25
delay 0.15
enhancer 0.30
width 1.20

# ════════════════════════════════════
#  7. KITS & SYNTHS
# ════════════════════════════════════
# kit 808          # classic drums
# kit modern       # jazz/industrial
# kit chops        # amen breaks
# kit synth        # supersaw/pluck/pad/bass/lead

# ════════════════════════════════════
#  8. TRANSFORMS
# ════════════════════════════════════
# reverse kick
# rotate snare 4
# prob hh 0.7
# euclidean perc 5 16

# ════════════════════════════════════
#  9. BIDIRECTIONAL
# ════════════════════════════════════
# Everything here syncs with:
#   SEQUENCER — visual step grid
#   PIANO ROLL — note editor
#   MIXER — levels and effects
#   SAVE/LOAD — .bfs files ARE the project
