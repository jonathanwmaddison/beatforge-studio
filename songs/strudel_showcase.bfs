# ═══════════════════════════════════════════
#  "Pattern Algebra" — Strudel Feature Showcase
#  Demonstrates every BeatForge Script feature
# ═══════════════════════════════════════════

bpm 120
swing 0

# ════════════════════════════════════
#  1. TRACKER NOTATION
#     Traditional step sequencer style
# ════════════════════════════════════

kick  "x...x...x...x..."
snare "....x.......x..."
hh    "x.x.x.x.x.x.x.x."

# Velocity: x=hard, o=medium, +=soft, .=rest
hh    "x.o+x.o+x.o+x.o+"

# ════════════════════════════════════
#  2. MINI-NOTATION
#     Strudel-style one-liners
# ════════════════════════════════════

# Basic sequence (evenly divided):
"kick snare hh clap"

# Repeat (hh plays 8 times):
"kick snare hh*8 clap"

# Subdivision (snare+clap in half the time):
"kick [snare clap] hh*4"

# ════════════════════════════════════
#  3. STRUDEL CHAINING
#     s() and n() with transforms
# ════════════════════════════════════

# Speed up the whole pattern:
s("kick snare hh clap").fast(2)

# Reverse:
s("kick snare hh clap").rev()

# Euclidean rhythm:
s("kick").euclid(3,8)

# ════════════════════════════════════
#  4. ADVANCED OPERATORS
# ════════════════════════════════════

# Stack (play simultaneously):
# "kick , hh*4"

# Random choice (different each cycle):
# "kick | snare | clap"

# Probability (50% chance each hit):
# "hh*8?0.5"

# Euclidean shorthand:
# "kick(3,16)"
# "snare(5,16)"
# "hh(7,16)"

# ════════════════════════════════════
#  5. MELODY
# ════════════════════════════════════

# Note names → piano roll:
note "C4 E4 G4 C5"

# With rests:
note "C4 ~ E4 ~ G4 ~ C5 ~"

# With repeats:
note "C4*2 E4 G4*2 C5"

# Sharps and flats:
note "C4 D#4 F#4 A4"
note "Db4 Eb4 Gb4 Bb4"

# ════════════════════════════════════
#  6. TRANSFORMS
# ════════════════════════════════════

# Reverse a pattern:
reverse kick

# Rotate (shift right):
rotate snare 4

# Probability (keep 70% of hits):
prob hh 0.7

# Euclidean distribution:
euclidean perc 5 16
euclidean cowbell 3 16

# ════════════════════════════════════
#  7. GLOBAL COMMANDS
# ════════════════════════════════════

bpm 120
swing 25
reverb 0.3
delay 0.2

# ════════════════════════════════════
#  8. BIDIRECTIONAL WORKFLOW
# ════════════════════════════════════

# Everything here can be:
# 1. Typed as code (this file)
# 2. Edited in the visual grid (SEQUENCER tab)
# 3. Edited in the piano roll (PIANO ROLL tab)
# 4. Converted back to code (GRID → CODE button)
#
# The three views are the SAME DATA:
#   Code ←→ Grid ←→ Piano Roll
#
# Edit anywhere, see updates everywhere.
