# ═══════════════════════════════════════════
#  "Midnight Session" — Full Production Demo
#  Shows EVERY BeatForge Script feature
# ═══════════════════════════════════════════

# ── Setup ────────────────────────────────
bpm 88
swing 30
steps 32
kit 808

# ── Master chain ─────────────────────────
reverb 0.25
delay 0.15
enhancer 0.3
width 1.2

# ── Drums (2-bar loop) ──────────────────
kick  "x.....x...x.....x.....x.x.x....."
snare "....x.......x.......x.......x..+"
hh    "x.xox.x.x.xox.x.x.xox.x.x.xox.x."
clap  "....x.......x.......x.......x..."

# ── Drum mix ─────────────────────────────
vol kick 0.9
vol snare 0.75
vol hh 0.55
vol clap 0.6

pan hh -0.25
filter kick 250
lpf hh 6000
dist kick 0.15

# ── Sidechain ────────────────────────────
sidechain kick snare
sidechain kick hh

# ── Synth bass ───────────────────────────
synth pad10 "808 Sub"
note "C2 ~ ~ ~ Eb2 ~ ~ ~ G1 ~ ~ ~ ~ ~ Ab1 ~ C2 ~ ~ ~ Eb2 ~ ~ ~ G1 ~ ~ ~ ~ ~ ~ ~"

# ── Lead melody ──────────────────────────
synth pad12 "Saw Lead"
note "C4 ~ Eb4 ~ G4 ~ Eb4 C4 ~ ~ Bb3 ~ ~ ~ ~ ~ C4 ~ Eb4 ~ G4 Bb4 G4 Eb4 C4 ~ ~ ~ ~ ~ ~ ~"

# ── Euclidean percussion ─────────────────
euclidean perc 5 32
euclidean cowbell 3 32
vol perc 0.3
vol cowbell 0.25

# ── FX sends ─────────────────────────────
sendverb snare 0.2
senddly clap 0.3
